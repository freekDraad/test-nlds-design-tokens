          "value": "{tilburg.feedback.negative.border-color}",
          "type": "color"
        },
        "border-inline-start-width": {
          "value": "{tilburg.border-width.md}",
          "type": "borderWidth"
        },
        "padding-inline-start": {
          "value": "{tilburg.space.inline.mouse}",
          "type": "spacing"
        }
      }
    }
  },
  "input-border-radius": {
    "value": "{tilburg.border-radius.none}",
    "type": "borderRadius"
  }
}